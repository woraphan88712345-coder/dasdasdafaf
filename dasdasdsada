            if Remotes.ReturnToLobby then
                pcall(function()
                    Remotes.ReturnToLobby:FireServer()
                end)
            end
            TeleportService:Teleport(LOBBY_PLACE_ID, LocalPlayer)
        end
    })

    -- VISUALS TAB
    local VisualTab = Window:Tab({
        Title = "Visuals",
        Icon = "eye"
    })

    VisualTab:Section({
        Title = "ESP",
        Icon = "scan"
    })

    bindToggle(
        VisualTab,
        IS_BASEMENT and "Key ESP" or "Needle ESP",
        "NeedleESP"
    )

    bindToggle(
        VisualTab,
        "Rare / RGB ESP",
        "RgbESP"
    )

    bindToggle(
        VisualTab,
        "Gem ESP",
        "GemESP"
    )

    bindToggle(
        VisualTab,
        "Sell ESP",
        "SellESP"
    )

    bindToggle(
        VisualTab,
        "Player ESP",
        "PlayerESP"
    )

    VisualTab:Section({
        Title = "Camera / Movement",
        Icon = "camera"
    })

    bindToggle(VisualTab, "Unlock Camera", "UnlockCamera")
    bindSlider(VisualTab, "Camera Zoom", "CameraZoomDistance", 5, 100, 1)

    VisualTab:Button({
        Title = "Force 3rd Person",
        Callback = function()
            forceSnap3rdPerson(HubState.CameraZoomDistance)
        end
    })

    bindToggle(VisualTab, "WalkSpeed", "WalkSpeedEnabled")
    bindSlider(VisualTab, "WalkSpeed Value", "WalkSpeed", 16, 150, 1)

    bindToggle(VisualTab, "Jump Height", "JumpHeightEnabled")
    bindSlider(VisualTab, "Jump Height Value", "JumpHeight", 7.2, 150, 1)

    bindToggle(VisualTab, "Fly", "FlyEnabled")
    bindSlider(VisualTab, "Fly Speed", "FlySpeed", 20, 200, 5)

    bindToggle(VisualTab, "Noclip", "NoclipEnabled")
    bindToggle(VisualTab, "Infinite Jump", "InfiniteJump")

    -- BASEMENT TAB
    if IS_BASEMENT then
        local BasementTab = Window:Tab({
            Title = "Basement",
            Icon = "key-round"
        })

        BasementTab:Section({
            Title = "Chapter 2",
            Icon = "door-open"
        })

        BasementTab:Paragraph({
            Title = "Objective",
            Desc = "Find the key, complete the levers and puzzles, then open the exit."
        })

        bindToggle(
            BasementTab,
            "Auto Levers",
            "BasementAutoLevers",
            "Automatically activates valid lever steps while aiming."
        )

        bindToggle(
            BasementTab,
            "Objective ESP",
            "BasementGuideESP",
            "Highlights the current basement objective."
        )

        BasementTab:Button({
            Title = "Sync Puzzle State",
            Callback = function()
                if PuzzleStateRemote then
                    pcall(function()
                        PuzzleStateRemote:FireServer()
                    end)
                    notify("Basement", "Puzzle state synced.", "refresh-cw")
                end
            end
        })

        BasementTab:Button({
            Title = "Show Next Objective",
            Callback = function()
                local text = getBasementNextObjective()
                notify("Objective", tostring(text), "target")
            end
        })
    end

    -- SETTINGS TAB
    local SettingsTab = Window:Tab({
        Title = "Settings",
        Icon = "settings"
    })

    SettingsTab:Section({
        Title = "Config",
        Icon = "save"
    })

    SettingsTab:Button({
        Title = "Save Config Now",
        Desc = "Immediately saves every UI setting.",
        Callback = function()
            Config:Save()
            notify("Config", "Saved successfully.", "save")
        end
    })

    local AutoSaveEnabled = cfg("AutoSaveEnabled", true)
    local AutoSaveDelay = tonumber(cfg("AutoSaveDelay", 15)) or 15
    local AutoSaveThread

    local function restartAutoSave()
        if AutoSaveThread then
            pcall(function()
                task.cancel(AutoSaveThread)
            end)
            AutoSaveThread = nil
        end

        if not AutoSaveEnabled then return end

        AutoSaveThread = task.spawn(function()
            while true do
                task.wait(AutoSaveDelay)
                Config:Save()
            end
        end)
    end

    SettingsTab:Toggle({
        Title = "Auto Save Config",
        Desc = "Automatically saves settings.",
        Value = AutoSaveEnabled,
        Callback = function(value)
            AutoSaveEnabled = value
            saveState("AutoSaveEnabled", value)
            restartAutoSave()
        end
    })

    SettingsTab:Input({
        Title = "Save Delay",
        Desc = "Seconds between automatic saves.",
        Value = tostring(AutoSaveDelay),
        Placeholder = "15",
        Callback = function(text)
            local value = tonumber(text)
            if value and value >= 1 then
                AutoSaveDelay = value
                saveState("AutoSaveDelay", value)
                restartAutoSave()
            else
                notify("Config", "Invalid delay.", "alert-triangle")
            end
        end
    })

    SettingsTab:Button({
        Title = "Reset Saved Config",
        Desc = "Deletes the saved DYHUB configuration.",
        Callback = function()
            Config.Data = {}
            pcall(function()
                if isfile(ConfigPath) then
                    delfile(ConfigPath)
                end
            end)
            notify("Config", "Saved config reset. Re-run the script.", "trash-2")
        end
    })

    restartAutoSave()
    Window:SelectTab(1)

    print("[DYHUB] SEARCH FOR THE NEEDLE engine + WindUI loaded | " .. ver)
end

