local function selectedNamesFromOption(optionValue)
    local names = {}
    for name, state in optionValue do
        if state then
            names[#names + 1] = name
        end
    end
    return names
end

local function getMyPlotBySign()
    local playerPlots = workspace:FindFirstChild("BigField")
        and workspace.BigField:FindFirstChild("PlayerPlots")
    local root = getRoot()
    if not playerPlots then
        return nil
    end

    -- Method 1: owner sign text
    for _, plot in pairs(playerPlots:GetChildren()) do
        local signName = plot:FindFirstChild("OwnerSign")
            and plot.OwnerSign:FindFirstChild("Sign")
            and plot.OwnerSign.Sign:FindFirstChild("SurfaceGui")
            and plot.OwnerSign.Sign.SurfaceGui:FindFirstChild("Frame")
            and plot.OwnerSign.Sign.SurfaceGui.Frame:FindFirstChild("PlayerName")
        if signName and signName:IsA("TextLabel") then
            if signName.Text == LocalPlayer.Name or signName.Text == LocalPlayer.DisplayName then
                return plot
            end
        end
    end

    -- Method 2: nearest plot with dirt
    if root then
        local closest, closestDist = nil, math.huge
        for _, plot in pairs(playerPlots:GetChildren()) do
            local plot1 = plot:FindFirstChild("Plot1")
            if plot1 and plot1:FindFirstChild("Dirt") then
                local dist = (plot1.Dirt.Position - root.Position).Magnitude
                if dist < closestDist then
                    closest, closestDist = plot, dist
                end
            end
        end
        if closest and closestDist < 150 then
            return closest
        end
    end
    return nil
end

local function doPickupFruit()
    local character = getCharacter()
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not root or not playerGui then
        return
    end

    local selectedFruits = selectedNamesFromOption(Options.PickupFruits.Value or {})
    local selectedMutations = selectedNamesFromOption(Options.PickupMutations.Value or {})
    local maxMultiplier = tonumber(Options.PickupMaxMultiplier.Value) or 0

    local myPlot = getMyPlot() or getMyPlotBySign()
    if not myPlot then
        return
    end

    local plotBillboards = playerGui:FindFirstChild("PlotBillboards")
    if not plotBillboards then
        return
    end

    for _, billboard in pairs(plotBillboards:GetChildren()) do
        if Library.Unloaded or not Toggles.AutoPickupFruit.Value then
            break
        end
        if billboard:IsA("BillboardGui") and billboard.Adornee then
            local fruitPart = billboard.Adornee
            local okDesc, isOnPlot = pcall(function()
                return fruitPart:IsDescendantOf(myPlot)
            end)
            if okDesc and isOnPlot and fruitPart:IsA("BasePart") then
                local mainFrame = billboard:FindFirstChild("MainFrame")
                local textLabel = mainFrame and mainFrame:FindFirstChild("Name")
                local prompt = fruitPart:FindFirstChildWhichIsA("ProximityPrompt")

                if textLabel and textLabel:IsA("TextLabel") and prompt
                    and string.find(string.lower(prompt.ActionText), "collect") then

                    local allText = textLabel.Text

                    local isValidFruit = #selectedFruits == 0
                    if not isValidFruit then
                        for _, selectedFruit in ipairs(selectedFruits) do
                            local cleanName = string.gsub(selectedFruit, "Fruit", "")
                            if string.find(string.lower(allText), string.lower(cleanName), 1, true) then
                                isValidFruit = true
                                break
                            end
                        end
                    end

                    local isValidMutation = #selectedMutations == 0
                    if not isValidMutation then
                        for _, selectedMut in ipairs(selectedMutations) do
                            if string.find(string.lower(allText), string.lower(selectedMut), 1, true) then
                                isValidMutation = true
                                break
                            end
                        end
                    end

                    local isValidMulti = true
                    if maxMultiplier > 0 then
                        local extractedMulti = string.match(allText, "([%d%.]+)x")
                        if extractedMulti and tonumber(extractedMulti) > maxMultiplier then
                            isValidMulti = false
                        end
                    end

                    if isValidFruit and isValidMutation and isValidMulti then
                        repeat
                            task.wait(0.1)
                        until not IsActionBusy or Library.Unloaded
                        IsActionBusy = true

                        root.CFrame = fruitPart.CFrame + Vector3.new(0, 3, 0)
                        task.wait(0.2)
                        pcall(fireproximityprompt, prompt)
                        task.wait(0.3)

                        IsActionBusy = false
                    end
                end
            end
        end
    end
end

