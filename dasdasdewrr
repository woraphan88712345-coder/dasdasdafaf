local function countFruitTools()
    local count = 0
    local character = getCharacter()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    for _, container in { character, backpack } do
        if container then
            for _, tool in container:GetChildren() do
                if tool:IsA("Tool") and tool:GetAttribute("IsFruit") then
                    count += 1
                end
            end
        end
    end
    return count
end

local function doSellFruits()
    local character = getCharacter()
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not humanoid or not backpack then
        return
    end

    if countFruitTools() < (tonumber(Options.SellMinFruits.Value) or 1) then
        return
    end

    if Toggles.SellTeleport.Value then
        local field = workspace:FindFirstChild("BigField")
        local stand = field and field:FindFirstChild("SellStand")
        local root = getRoot()
        local pivot = stand and stand:GetPivot()
        if root and pivot then
            root.CFrame = pivot + Vector3.new(0, 5, 0)
            task.wait(0.2)
        end
    end

    while not Library.Unloaded and Toggles.AutoSellFruits.Value do
        local fruit
        for _, tool in character:GetChildren() do
            if tool:IsA("Tool") and tool:GetAttribute("IsFruit") then
                fruit = tool
                break
            end
        end
        if not fruit then
            for _, tool in backpack:GetChildren() do
                if tool:IsA("Tool") and tool:GetAttribute("IsFruit") then
                    humanoid:EquipTool(tool)
                    fruit = tool
                    break
                end
            end
        end
        if not fruit then
            break
        end
        SellFruitsService:SellFruit():await()
        task.wait(Options.SellActionDelay.Value or 0.2)
    end
end

local function doSellAll()
    SellStandService:SellAll():await()
end

-- Sell Filter By Name  [from script 1]
local function doSellByName()
    local selectedItems = {}
    for name in pairs(wantedSellNames) do
        selectedItems[#selectedItems + 1] = name
    end
    if #selectedItems == 0 then
        return
    end

    local character = getCharacter()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not character or not backpack then
        return
    end

    local tools = backpack:GetChildren()
    for _, tool in pairs(character:GetChildren()) do
        if tool:IsA("Tool") then
            table.insert(tools, tool)
        end
    end

    for _, tool in ipairs(tools) do
        if Library.Unloaded then
            break
        end
        if tool:IsA("Tool") then
            local itemName = tool.Name
            local isSelected = false
            for _, selectedItem in ipairs(selectedItems) do
                local cleanTarget = string.lower(string.gsub(selectedItem, "Fruit", ""))
                if cleanTarget ~= "" and string.find(string.lower(itemName), cleanTarget, 1, true) then
                    isSelected = true
                    break
                end
            end

            if isSelected then
                local uuid = tool:GetAttribute("ItemId") or tool.Name
                local ok = pcall(function()
                    SellStandService:SellTree(uuid):await()
                end)
                if not ok then
                    pcall(function()
                        local rf = ReplicatedStorage
                            :WaitForChild("Packages"):WaitForChild("_Index")
                            :WaitForChild("sleitnick_knit@1.6.0"):WaitForChild("knit")
                            :WaitForChild("Services"):WaitForChild("SellStandService")
                            :WaitForChild("RF"):WaitForChild("SellTree")
                        rf:InvokeServer(uuid)
                    end)
                end
                task.wait(Options.SellActionDelay.Value or 0.2)
            end
        end
    end
end

