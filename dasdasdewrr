local function findEmptyPlotPosition(myPlotFolder, myDirt)
    local size = myDirt.Size
    local baseCF = myDirt.CFrame

    for x = -size.X / 2 + 8, size.X / 2 - 8, 12 do
        for z = -size.Z / 2 + 8, size.Z / 2 - 8, 12 do
            local testPos = (baseCF * CFrame.new(x, size.Y / 2, z)).Position
            local occupied = false

            for _, obj in pairs(myPlotFolder:GetChildren()) do
                if string.find(obj.Name, "PlotTree") and obj:GetPivot() then
                    local treePos = obj:GetPivot().Position
                    local dist = (Vector3.new(treePos.X, 0, treePos.Z) - Vector3.new(testPos.X, 0, testPos.Z)).Magnitude
                    if dist < 8 then
                        occupied = true
                        break
                    end
                end
            end

            if not occupied then
                return testPos
            end
        end
    end
    return nil
end

local function doPlantPlot()
    local selectedPlants = selectedNamesFromOption(Options.PlotPlants.Value or {})
    if #selectedPlants == 0 then
        return
    end

    local character = getCharacter()
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        return
    end

    -- Locate my plot + dirt
    local playerPlots = workspace:FindFirstChild("BigField")
        and workspace.BigField:FindFirstChild("PlayerPlots")
    if not playerPlots then
        return
    end

    local myPlotFolder, myDirt = nil, nil
    for _, plotDir in pairs(playerPlots:GetChildren()) do
        local plot1 = plotDir:FindFirstChild("Plot1")
        if plot1 and plot1:FindFirstChild("Dirt") then
            local dirt = plot1.Dirt
            if dirt:GetAttribute("OwnerUserId") == LocalPlayer.UserId
                or (getRoot() and (dirt.Position - getRoot().Position).Magnitude < 200) then
                myPlotFolder = plotDir
                myDirt = dirt
                break
            end
        end
    end
    if not myPlotFolder or not myDirt then
        return
    end

    -- Check plot is not already full
    local emptyPos = findEmptyPlotPosition(myPlotFolder, myDirt)
    if not emptyPos then
        return
    end

    -- Find matching hotbar slot by scanning the on-screen hotbar
    local targetSlot = scanHotbarSlot(selectedPlants)
    if not targetSlot then
        return
    end

    repeat
        task.wait(0.1)
    until not IsActionBusy or Library.Unloaded
    IsActionBusy = true

    local tool = equipSlotAndWait(targetSlot, 3)
    local targetUUID = tool and tool:GetAttribute("ItemId")

    if targetUUID then
        -- Re-check an empty position after equipping
        emptyPos = findEmptyPlotPosition(myPlotFolder, myDirt)
        local root = getRoot()
        if emptyPos and root then
            root.CFrame = CFrame.new(emptyPos) + Vector3.new(0, 4, 0)
            task.wait(0.5)

            local ok = pcall(function()
                PlayerPlotService:PlantTree(targetUUID, emptyPos, 0):await()
            end)
            if not ok then
                -- Fallback: direct RF invoke
                pcall(function()
                    local rf = ReplicatedStorage
                        :WaitForChild("Packages"):WaitForChild("_Index")
                        :WaitForChild("sleitnick_knit@1.6.0"):WaitForChild("knit")
                        :WaitForChild("Services"):WaitForChild("PlayerPlotService")
                        :WaitForChild("RF"):WaitForChild("PlantTree")
                    rf:InvokeServer(targetUUID, emptyPos, 0)
                end)
            end
            task.wait(1.5)
        end
    end

    IsActionBusy = false
end

