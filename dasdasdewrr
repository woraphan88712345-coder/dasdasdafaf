-- Scan the on-screen hotbar for a slot whose label matches one of `names`
-- (case-insensitive, spaces stripped). Returns slotNumber, matchedName.
local function scanHotbarSlot(names)
    local slotsFrame = getHotbarSlotsFrame()
    if not slotsFrame then
        return nil, nil
    end
    for _, slotFrame in ipairs(slotsFrame:GetChildren()) do
        if slotFrame:IsA("GuiObject") then
            local isTarget = false
            local matchedName = nil
            for _, desc in ipairs(slotFrame:GetDescendants()) do
                if desc:IsA("TextLabel") then
                    local txtLower = string.lower(string.gsub(desc.Text, " ", ""))
                    for _, n in ipairs(names) do
                        local targetName = string.lower(string.gsub(n, " ", ""))
                        targetName = string.gsub(targetName, "avacado", "avocado")
                        if targetName ~= "" and string.find(txtLower, targetName, 1, true) then
                            isTarget = true
                            matchedName = n
                            break
                        end
                    end
                end
                if isTarget then
                    break
                end
            end

            if isTarget then
                local slotNumber = nil
                for _, desc in ipairs(slotFrame:GetDescendants()) do
                    if desc:IsA("TextLabel") then
                        local textVal = string.gsub(desc.Text, " ", "")
                        local num = tonumber(textVal)
                        if num and tostring(num) == textVal then
                            slotNumber = num
                            break
                        end
                    end
                end
                if not slotNumber then
                    slotNumber = tonumber(string.match(slotFrame.Name, "%d+"))
                end
                return slotNumber, matchedName
            end
        end
    end
    return nil, nil
end

local function equipSlotAndWait(slotNumber, timeout)
    local character = getCharacter()
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        pcall(function()
            humanoid:UnequipTools()
        end)
    end
    task.wait(0.2)
    ToolService.ToggleEquip:Fire(true, slotNumber)
    pcall(function()
        local keyCode = Enum.KeyCode["Number" .. tostring(slotNumber)]
        if keyCode then
            VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
            task.wait(0.1)
            VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
        end
    end)
    local deadline = tick() + (timeout or 3)
    repeat
        task.wait(0.1)
        character = getCharacter()
    until (character and character:FindFirstChildWhichIsA("Tool")) or tick() > deadline
    return character and character:FindFirstChildWhichIsA("Tool") or nil
end

